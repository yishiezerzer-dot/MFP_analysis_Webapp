        "tolerance_unit": "ppm",
        "min_series_points": 2
      },
      "expected": {
        "series_count": 1,
        "series_0_count": 2
      }
    },
    {
      "name": "minSeriesPoints filters small clusters",
      "input": {
        "mz": [100, 200],
        "intensity": [100, 90],
        "repeat_mass": 100.0,
        "min_rel_intensity": 0,
        "tolerance_value": 0.01,
